# env
PORT=5550
NODE_ENV=development

# JWT
JWT_ISSUER=muraasla
JWT_SECRET=dev_super_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DB
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3307          # ✅ use the published host port
DB_NAME=whatsapp_portal
DB_USER=root
DB_PASSWORD=root
# Pool (dev)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Services (dev)
MQTT_BROKER_URL=mqtt://localhost
WHATSAPP_SERVICE_URL=https://chatfusion.murraltd.com/api

SEED_TZ=Asia/Hebron
SERVER_DEFAULT_TZ=Asia/Hebron
# MySQL variables (for database.js compatibility)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=whatsapp_portal
MYSQL_USER=root
MYSQL_PASSWORD=root

# ChatFusion API Endpoints
CHATFUSION_STATUS_URL=https://chatfusion.murraltd.com/api/whatsapp/status
CHATFUSION_CONNECT_URL=https://chatfusion.murraltd.com/api/whatsapp/connect
CHATFUSION_DISCONNECT_URL=https://chatfusion.murraltd.com/api/whatsapp/disconnect
CHATFUSION_CHECK_NUMBER_URL=https://chatfusion.murraltd.com/api/whatsapp/check-whatsapp-number
CHATFUSION_CONTACT_URL=https://chatfusion.murraltd.com/api/whatsapp/contact
CHATFUSION_RESET_API_KEY_URL=https://chatfusion.murraltd.com/api/auth/reset-api-key
CHATFUSION_UPDATE_API_KEY_URL=https://chatfusion.murraltd.com/api/auth/update-api-key

# ChatFusion Messaging Endpoints
CHATFUSION_SEND_MESSAGE_URL=https://chatfusion.murraltd.com/api/messaging/send
CHATFUSION_SEND_BULK_URL=https://chatfusion.murraltd.com/api/messaging/send-bulk
