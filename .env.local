# Local Development Environment Configuration
# For running everything locally (backend + database + ChatFusion service)

# Server Configuration
PORT=5550
NODE_ENV=development
HOST=0.0.0.0

# JWT Configuration
JWT_ISSUER=muraasla
JWT_SECRET=local_dev_secret
JWT_REFRESH_SECRET=local_dev_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (Local MySQL)
DB_DIALECT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=whatsapp_portal
MYSQL_USER=root
MYSQL_PASSWORD=root

# Database Pool Configuration (Local)
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Services Configuration
MQTT_BROKER_URL=mqtt://localhost
WHATSAPP_SERVICE_URL=http://localhost:5500/api

# ChatFusion API Configuration (Local Service)
CHATFUSION_BASE_URL=http://localhost:5500/api
CHATFUSION_AUTH_PROFILE_URL=http://localhost:5500/api/auth/profile
CHATFUSION_AUTH_RESET_KEY_URL=http://localhost:5500/api/auth/reset-api-key
CHATFUSION_AUTH_UPDATE_KEY_URL=http://localhost:5500/api/auth/update-api-key
CHATFUSION_WHATSAPP_STATUS_URL=http://localhost:5500/api/whatsapp/status
CHATFUSION_WHATSAPP_CONNECT_URL=http://localhost:5500/api/whatsapp/connect
CHATFUSION_WHATSAPP_DISCONNECT_URL=http://localhost:5500/api/whatsapp/disconnect
CHATFUSION_WHATSAPP_CHECK_NUMBER_URL=http://localhost:5500/api/whatsapp/check-whatsapp-number
CHATFUSION_WHATSAPP_CONTACT_URL=http://localhost:5500/api/whatsapp/contact
CHATFUSION_MESSAGING_SEND_URL=http://localhost:5500/api/messaging/send
CHATFUSION_MESSAGING_SEND_BULK_URL=http://localhost:5500/api/messaging/sendBulk
CHATFUSION_MESSAGING_SEND_GROUP_URL=http://localhost:5500/api/messaging/sendGroup
CHATFUSION_HISTORY_URL=http://localhost:5500/api/history
CHATFUSION_HISTORY_DATE_RANGE_URL=http://localhost:5500/api/history/date-range
CHATFUSION_USERS_BALANCE_URL=http://localhost:5500/api/users/balance
CHATFUSION_USERS_CREATE_URL=http://localhost:5500/api/users/create

# Timezone Configuration
SEED_TZ=Asia/Hebron
SERVER_DEFAULT_TZ=Asia/Hebron

# Rate Limiting (Local)
RATE_LIMIT=off
RATE_WINDOW_MS=900000
RATE_MAX=1000

# Trust Proxy (Local)
TRUST_PROXY=false

# Debug Configuration
DEBUG=true
LOG_LEVEL=debug
