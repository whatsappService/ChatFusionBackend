# env
PORT=5550
NODE_ENV=development

# JWT
JWT_ISSUER=muraasla
JWT_SECRET=dev_super_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DB
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3307          # ✅ use the published host port
DB_NAME=whatsapp_portal
