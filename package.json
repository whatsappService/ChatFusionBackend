{
  "name": "whatsapp-portal-backend",
  "version": "1.0.0",
  "description": "Backend for WhatsApp Portal",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "migrate:dev": "NODE_ENV=development npx sequelize-cli db:migrate --config src/config/config.js --migrations-path src/migrations",
    "migrate:prod": "NODE_ENV=production npx sequelize-cli db:migrate --config src/config/config.js",
    "seed:dev": "NODE_ENV=development npx sequelize-cli db:seed:all --config src/config/config.js  --seeders-path src/seeders",
    "seed:prod": "NODE_ENV=production npx sequelize-cli db:seed:all --config src/config/config.js",
    "rollback:dev": "NODE_ENV=development npx sequelize-cli db:migrate:undo:all --config src/config/config.js --migrations-path src/migrations",
    "rollback:prod": "NODE_ENV=production npx sequelize-cli db:migrate:undo:all --config src/config/config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "mqtt": "^4.3.7",
    "mysql2": "^3.2.4",
    "selenium-webdriver": "^4.15.0",
    "sequelize": "^6.31.0",
    "winston": "^3.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "sequelize-cli": "^6.4.1"
  }
}
