# Production Environment Configuration
# For Docker production with external database and ChatFusion service

# Server Configuration
PORT=5550
NODE_ENV=production
HOST=0.0.0.0

# JWT Configuration
JWT_ISSUER=muraasla
JWT_SECRET=70b1e6adfca78bebfe9363ff635009f72a7a2a3c818bf9225e065b8c4b92eda5a832874a9877c077d64d11566569231d4470f3a0fd53926e4d31b8ad7af1e6d4
JWT_REFRESH_SECRET=prod_refresh_secret_change_me_in_production

# Database Configuration (External MySQL on host port 3307)
DB_DIALECT=mysql
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_DB=whatsapp_portal
MYSQL_USER=root
MYSQL_PASSWORD=root

# Database Pool Configuration (Production)
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Services Configuration
MQTT_BROKER_URL=mqtt://prod-mqtt-broker
WHATSAPP_SERVICE_URL=https://be.muraasala.com

# ChatFusion API Configuration (Production Service)
CHATFUSION_BASE_URL=https://be.muraasala.com
CHATFUSION_AUTH_PROFILE_URL=https://be.muraasala.com/api/auth/profile
CHATFUSION_AUTH_RESET_KEY_URL=https://be.muraasala.com/api/auth/reset-api-key
CHATFUSION_AUTH_UPDATE_KEY_URL=https://be.muraasala.com/api/auth/update-api-key
CHATFUSION_WHATSAPP_STATUS_URL=https://be.muraasala.com/api/whatsapp/status
CHATFUSION_WHATSAPP_CONNECT_URL=https://be.muraasala.com/api/account/connect
CHATFUSION_WHATSAPP_DISCONNECT_URL=https://be.muraasala.com/api/account/disconnect
CHATFUSION_WHATSAPP_CHECK_NUMBER_URL=https://be.muraasala.com/api/whatsapp/check-whatsapp-number
CHATFUSION_WHATSAPP_CONTACT_URL=https://be.muraasala.com/api/whatsapp/contact
CHATFUSION_MESSAGING_SEND_URL=https://be.muraasala.com/api/messages/send
CHATFUSION_MESSAGING_SEND_BULK_URL=https://be.muraasala.com/api/messages/bulk
CHATFUSION_MESSAGING_SEND_GROUP_URL=https://be.muraasala.com/api/messages/group
CHATFUSION_HISTORY_URL=https://be.muraasala.com/api/history
CHATFUSION_HISTORY_DATE_RANGE_URL=https://be.muraasala.com/api/history/date-range
CHATFUSION_USERS_BALANCE_URL=https://be.muraasala.com/api/users/balance
CHATFUSION_USERS_CREATE_URL=https://be.muraasala.com/api/users/create

# Timezone Configuration
SEED_TZ=Asia/Hebron
SERVER_DEFAULT_TZ=Asia/Hebron

# Rate Limiting (Production)
RATE_LIMIT=on
RATE_WINDOW_MS=900000
RATE_MAX=1000

# Trust Proxy (Production - Docker)
TRUST_PROXY=true

# Debug Configuration
DEBUG=false
LOG_LEVEL=info

# Group Management Endpoints
CHATFUSION_GET_GROUPS_URL=https://be.muraasala.com/api/group/get-groups
CHATFUSION_SEND_GROUP_URL=https://be.muraasala.com/api/messages/sendGroup
CHATFUSION_ACCOUNTS_URL=https://be.muraasala.com/api/accounts
