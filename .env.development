# Development Environment Configuration
# For local development with external database and ChatFusion service

# Server Configuration
PORT=5550
NODE_ENV=development
HOST=0.0.0.0

# JWT Configuration
JWT_ISSUER=muraasla
JWT_SECRET=dev_super_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (External MySQL on port 3307)
DB_DIALECT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=whatsapp_portal
MYSQL_USER=root
MYSQL_PASSWORD=root

# Database Pool Configuration (Development)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Services Configuration
MQTT_BROKER_URL=mqtt://localhost
WHATSAPP_SERVICE_URL=https://chatfusion.murraltd.com/api

# ChatFusion API Configuration (External Service)
CHATFUSION_BASE_URL=https://chatfusion.murraltd.com/api
CHATFUSION_AUTH_PROFILE_URL=https://chatfusion.murraltd.com/api/auth/profile
CHATFUSION_AUTH_RESET_KEY_URL=https://chatfusion.murraltd.com/api/auth/reset-api-key
CHATFUSION_AUTH_UPDATE_KEY_URL=https://chatfusion.murraltd.com/api/auth/update-api-key
CHATFUSION_WHATSAPP_STATUS_URL=https://chatfusion.murraltd.com/api/whatsapp/status
CHATFUSION_WHATSAPP_CONNECT_URL=https://chatfusion.murraltd.com/api/whatsapp/connect
CHATFUSION_WHATSAPP_DISCONNECT_URL=https://chatfusion.murraltd.com/api/whatsapp/disconnect
CHATFUSION_WHATSAPP_CHECK_NUMBER_URL=https://chatfusion.murraltd.com/api/whatsapp/check-whatsapp-number
CHATFUSION_WHATSAPP_CONTACT_URL=https://chatfusion.murraltd.com/api/whatsapp/contact
CHATFUSION_MESSAGING_SEND_URL=https://chatfusion.murraltd.com/api/messaging/send
CHATFUSION_MESSAGING_SEND_BULK_URL=https://chatfusion.murraltd.com/api/messaging/sendBulk
CHATFUSION_MESSAGING_SEND_GROUP_URL=https://chatfusion.murraltd.com/api/messaging/sendGroup
CHATFUSION_HISTORY_URL=https://chatfusion.murraltd.com/api/history
CHATFUSION_HISTORY_DATE_RANGE_URL=https://chatfusion.murraltd.com/api/history/date-range
CHATFUSION_USERS_BALANCE_URL=https://chatfusion.murraltd.com/api/users/balance
CHATFUSION_USERS_CREATE_URL=https://chatfusion.murraltd.com/api/users/create

# Timezone Configuration
SEED_TZ=Asia/Hebron
SERVER_DEFAULT_TZ=Asia/Hebron

# Rate Limiting (Development)
RATE_LIMIT=on
RATE_WINDOW_MS=900000
RATE_MAX=1000

# Trust Proxy (Development)
TRUST_PROXY=false

# Debug Configuration
DEBUG=true
LOG_LEVEL=debug
