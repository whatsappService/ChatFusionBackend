DB_PASSWORD=root
# Pool (dev)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Services (dev)
MQTT_BROKER_URL=mqtt://localhost
